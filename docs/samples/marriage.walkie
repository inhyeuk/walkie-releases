:"text","text":"④ 경찰 강력팀","x":84,"y":1964,"w":1192,"h":0,"fontSize":26,"color":"#455A64","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o47"},{"kind":"image","hash":"p_jang","x":140,"y":2028,"w":180,"h":225,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o48"},{"kind":"stroke","tool":"rect","points":[134,2260,326,2334],"color":"#455A64","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"장도식\n강력팀 팀장","id":"o49"},{"kind":"image","hash":"p_choi","x":560,"y":2028,"w":180,"h":225,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o50"},{"kind":"stroke","tool":"rect","points":[554,2260,746,2334],"color":"#455A64","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"최현수\n형사","id":"o51"},{"kind":"image","hash":"p_oh","x":980,"y":2028,"w":180,"h":225,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o52"},{"kind":"stroke","tool":"rect","points":[974,2260,1166,2334],"color":"#455A64","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"오승택\n형사","id":"o53"},{"kind":"image","hash":"s_phone","x":140,"y":2428,"w":300,"h":200,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o54"},{"kind":"text","text":"발신자 표시 제한 전화가 걸려오며 사건이 시작된다. 팀은 태주를 용의선상에 두고 추적하다가 나중에 용의선에서 벗어난다(9회)","x":460,"y":2448,"w":800,"h":0,"fontSize":16,"color":"#455A64","width":3,"tool":"","rotation":0,"id":"o55"},{"kind":"stroke","tool":"rect","points":[1380,1948,2520,2748],"color":"#B71C1C","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dash","id":"o56"},{"kind":"text","text":"⑤ 범죄와 단서 정리","x":1404,"y":1964,"w":1092,"h":0,"fontSize":26,"color":"#B71C1C","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o57"},{"kind":"table","text":"{\"rows\": 9, \"cols\": 3, \"cells\": [\"사건·단서\", \"회차\", \"관련 인물\", \"세윤 납치\", \"1–2\", \"노만희\", \"경찰서에 온 제보 메일\", \"2\", \"납치범\", \"살해된 여성의 사진\", \"4\", \"노만희\", \"동찬의 집 총성 두 발\", \"4\", \"고동찬 · 태주\", \"몸값 30억 원 거래\", \"5\", \"태주 · 납치범\", \"납치범의 집 주소 입수\", \"6\", \"강태주\", \"경애 살해 시도\", \"8\", \"하정수 · 최치웅\", \"과거의 살인과 시신 유기\", \"10\", \"노만희 · 김경애\"]}","x":1420,"y":2018,"w":1080,"h":432,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o58"},{"kind":"stroke","tool":"rect","points":[1420,2478,2500,2728],"color":"#B8860B","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFF6D5","text":"끝내 밝혀지지 않았다는 평가를 받은 것\n이수형의 생사, 그리고 범인이 이수형의 아내를 살해한 이유. 후반으로 갈수록 개연성 논란도 있었다는 평가가 있어요","id":"o59"},{"kind":"stroke","tool":"rect","points":[2600,1948,3780,2748],"color":"#2E7D32","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dash","id":"o60"},{"kind":"text","text":"⑥ 회차별 시청률","x":2624,"y":1964,"w":1132,"h":0,"fontSize":26,"color":"#2E7D32","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o61"},{"kind":"table","text":"{\"rows\": 13, \"cols\": 2, \"cells\": [\"회차\", \"시청률(%)\", \"E1\", \"4.4\", \"E2\", \"6.4\", \"E3\", \"5.3\", \"E4\", \"7.2\", \"E5\", \"5.0\", \"E6\", \"6.4\", \"E7\", \"4.8\", \"E8\", \"7.3\", \"E9\", \"7.5\", \"E10\", \"7.2\", \"E11\", \"7.5\", \"E12\", \"8.5\"]}","x":2640,"y":2018,"w":440,"h":442,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o62"},{"kind":"chart","text":"{\"src\": \"o62\", \"type\": \"line\", \"byRow\": false, \"labels\": true, \"legend\": false, \"title\": \"회차별 전국 시청률(닐슨코리아)\"}","x":3120,"y":2018,"w":640,"h":400,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o63"},{"kind":"text","text":"나무위키에 정리된 표 기준이며 보도에 따라 몇 회차는 조금 다를 수 있어요. 최종회가 자체 최고로 보도됐어요","x":3120,"y":2438,"w":640,"h":0,"fontSize":15,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o64"},{"kind":"stroke","tool":"arrow","points":[806,1207.0,1034,1207.0],"color":"#B71C1C","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o11#2","connEnd":"o13#6","dash":"solid","headSize":"m","headStart":"open","headEnd":"open","text":"위기의 부부","id":"o65"},{"kind":"stroke","tool":"line","points":[1130.0,1580,1130.0,1244],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o17#0","connEnd":"o13#4","dash":"dot","headSize":"m","headStart":"none","headEnd":"none","text":"부녀","id":"o66"},{"kind":"stroke","tool":"line","points":[986,1617.0,1034,1617.0],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o15#2","connEnd":"o17#6","dash":"dot","headSize":"m","headStart":"none","headEnd":"none","text":"부부","id":"o67"},{"kind":"stroke","tool":"line","points":[516,1207.0,614,1207.0],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o9#2","connEnd":"o11#6","dash":"dot","headSize":"m","headStart":"none","headEnd":"none","text":"형제","id":"o68"},{"kind":"stroke","tool":"line","points":[286,1207.0,324,1207.0],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o7#2","connEnd":"o9#6","dash":"dot","headSize":"m","headStart":"none","headEnd":"none","text":"모자","id":"o69"},{"kind":"stroke","tool":"arrow","points":[1666,1207.0,1954,1207.0],"color":"#B71C1C","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o26#2","connEnd":"o28#6","dash":"dot","headSize":"m","headStart":"open","headEnd":"open","text":"부부 · 운명 공동체","id":"o70"},{"kind":"stroke","tool":"arrow","points":[1474,1207.0,1226,1207.0],"color":"#B71C1C","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o26#6","connEnd":"o13#2","dash":"solid","headSize":"m","headStart":"none","headEnd":"triangle","text":"납치 · 협박","id":"o71"},{"kind":"stroke","tool":"arrow","points":[710.0,1244,650.0,1580],"color":"#455A64","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o11#4","connEnd":"o19#0","dash":"solid","headSize":"m","headStart":"none","headEnd":"triangle","text":"조력자","id":"o72"},{"kind":"stroke","tool":"arrow","points":[2674,1207.0,2146,1207.0],"color":"#6A1B9A","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o36#6","connEnd":"o28#2","dash":"solid","headSize":"m","headStart":"none","headEnd":"triangle","text":"뒤에서 조종한 배후","id":"o73"},{"kind":"stroke","tool":"arrow","points":[2866,1207.0,3174,1207.0],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o36#2","connEnd":"o38#6","dash":"dash","headSize":"m","headStart":"none","headEnd":"triangle","text":"지시: 경애 살해 시도(8회)","id":"o74"},{"kind":"stroke","tool":"arrow","points":[680.0,1948,680.0,1868],"color":"#455A64","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"connStart":"o46#0","connEnd":"o4#4","dash":"dash","headSize":"m","headStart":"none","headEnd":"triangle","text":"수사 · 추적","id":"o75"},{"kind":"text","text":"회차별 이야기 흐름","x":60,"y":2848,"w":2400,"h":0,"fontSize":34,"color":"#1A1D26","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o76"},{"kind":"stroke","tool":"line","points":[60,2900,3780,2900],"color":"#1565C0","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o77"},{"kind":"stroke","tool":"rect","points":[60,2948,650,3268],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"1회 · 7월 4일\nVIP 수술 문제로 부부가 크게 충돌하고 태주가 이혼을 말한다. 다음 날 세윤이 사라지고 발신자 표시 제한 전화가 걸려온다","id":"o78"},{"kind":"stroke","tool":"arrow","points":[654,3108,676,3108],"color":"#1565C0","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o79"},{"kind":"stroke","tool":"rect","points":[680,2948,1270,3268],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"2회 · 7월 5일\n태주가 처가에서 형사들과 마주친다. 세윤은 낮밤을 알 수 없는 방에서 깨어나고, 경찰서에 납치 제보 메일이 온다","id":"o80"},{"kind":"stroke","tool":"arrow","points":[1274,3108,1296,3108],"color":"#1565C0","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o81"},{"kind":"stroke","tool":"rect","points":[1300,2948,1890,3268],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"3회 · 7월 11일\n정해진 시간 안에 지정한 장소로 오라는 제안이 오고, 태주는 조사 중 경찰서를 탈출한다. 세윤은 \"빨간 모자 소녀\"의 뜻을 깨닫는다","id":"o82"},{"kind":"stroke","tool":"arrow","points":[1894,3108,1916,3108],"color":"#1565C0","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o83"},{"kind":"stroke","tool":"rect","points":[1920,2948,2510,3268],"color":"#B71C1C","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"4회 · 7월 12일\n태주가 경찰 포위망을 뚫고 도주한다. 살해된 여성의 사진이 던져지고, 밤에 동찬의 집에서 총성 두 발이 울린다","id":"o84"},{"kind":"stroke","tool":"arrow","points":[2514,3108,2536,3108],"color":"#B71C1C","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o85"},{"kind":"stroke","tool":"rect","points":[2540,2948,3130,3268],"color":"#B71C1C","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"5회 · 7월 18일\n납치범이 현금 30억 원에 거래에 응한다. 태주를 따르던 수형의 진짜 계획이 긴장을 높인다","id":"o86"},{"kind":"stroke","tool":"arrow","points":[3134,3108,3156,3108],"color":"#B71C1C","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o87"},{"kind":"stroke","tool":"rect","points":[3160,2948,3750,3268],"color":"#B71C1C","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"6회 · 7월 19일\n태주가 납치범의 집 주소를 알아낸다. 병원 진료실에 숨은 태주는 뜻밖의 인물과 마주치고, 탈출한 세윤은 어둠 속에서 차 한 대를 본다","id":"o88"},{"kind":"stroke","tool":"rect","points":[60,3308,650,3628],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"7회 · 7월 25일\n사이코패스 살인마의 본색을 드러낸 노만희가 등장한다. 태주와 세윤은 목숨을 건 사투를 벌인다","id":"o89"},{"kind":"stroke","tool":"arrow","points":[654,3468,676,3468],"color":"#6A1B9A","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o90"},{"kind":"stroke","tool":"rect","points":[680,3308,1270,3628],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"8회 · 7월 26일\n정수가 경애를 죽이려던 시도가 실패한다. \"시키는 대로 했을 뿐\"이라는 말이 태주의 마음에 걸리고, 병원 안의 누군가를 떠올린다","id":"o91"},{"kind":"stroke","tool":"arrow","points":[1274,3468,1296,3468],"color":"#6A1B9A","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o92"},{"kind":"stroke","tool":"rect","points":[1300,3308,1890,3628],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"9회 · 8월 1일\n태주가 용의선에서 벗어나고, 사건의 실마리를 찾으려 경애의 주치의를 자처한다. 장 팀장은 병원 CCTV에서 의외의 단서를 잡는다","id":"o93"},{"kind":"stroke","tool":"arrow","points":[1894,3468,1916,3468],"color":"#6A1B9A","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o94"},{"kind":"stroke","tool":"rect","points":[1920,3308,2510,3628],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"10회 · 8월 2일\n태주가 위험을 무릅쓰고 만희와 마주선다. 서로 몰랐던 진실이 드러나고, 만희와 경애의 과거가 공개된다. 엔딩에서 배후 최치웅의 얼굴이 드러난다","id":"o95"},{"kind":"stroke","tool":"arrow","points":[2514,3468,2536,3468],"color":"#2E7D32","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o96"},{"kind":"stroke","tool":"rect","points":[2540,3308,3130,3628],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"11회 · 8월 8일\n태주가 진짜 배후를 알아내지만 결정적 증거가 없다. 한밤에 화재경보가 울려 병원이 발칵 뒤집힌다","id":"o97"},{"kind":"stroke","tool":"arrow","points":[3134,3468,3156,3468],"color":"#2E7D32","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle","id":"o98"},{"kind":"stroke","tool":"rect","points":[3160,3308,3750,3628],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FFFFFF","text":"12회 · 8월 9일\n만희·치웅과 경애의 요양병원으로 향한다. 태주가 경애를 수술하고 만희와 치웅은 체포되며 동찬은 자수한다. 세윤은 이혼을 택하고 수목장에서 다시 만난다","id":"o99"},{"kind":"stroke","tool":"rect","points":[60,3688,1500,3828],"color":"#1565C0","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#E3F2FD","text":"색으로 보는 흐름\n파랑 = 납치와 시작(1–3회), 빨강 = 추격과 거래(4–6회), 보라 = 본색과 배후 추적(7–9회), 초록 = 전말과 결말(10–12회)","id":"o100"},{"kind":"stroke","tool":"rect","points":[1560,3688,3780,3828],"color":"#B71C1C","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#FDECEA","text":"이 보드에 대해\n공개된 방송 정보와 보도를 공부용으로 직접 요약한 예시예요. 대사·장면·포스터·배우 사진은 쓰지 않았고, 인물 카드는 얼굴 없는 그림이에요. 방송을 안 본 분은 결말 스포일러에 주의하세요. 출연: 남궁민·이설·김대명·이상희 외","id":"o101"},{"kind":"link","url":"https://namu.wiki/w/%EA%B2%B0%ED%98%BC%EC%9D%98%20%EC%99%84%EC%84%B1","x":60,"y":3868,"w":420,"h":90,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o102"},{"kind":"text","text":"주제 마인드맵","x":60,"y":4028,"w":1600,"h":0,"fontSize":30,"color":"#1A1D26","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o103"},{"kind":"stroke","tool":"rect","points":[1720.0,4368.0,2080.0,4488.0],"color":"#14213D","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":26,"rotation":0,"bg":"#E8ECF5","text":"결혼의 완성의 주제","font":"serif","tfmt":"bC","id":"o104","mmRoot":true},{"kind":"stroke","tool":"rect","points":[1280.0,4281.0,1580.0,4373.0],"color":"#B71C1C","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"부부","tfmt":"bC","id":"o105","mmParent":"o104","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[890.0,4258.0,1190.0,4320.0],"color":"#B71C1C","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"이혼 직전에 닥친 위기","id":"o106","mmParent":"o105","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[890.0,4334.0,1190.0,4396.0],"color":"#B71C1C","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"서로를 지키는 방식이 달랐다","id":"o107","mmParent":"o105","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[1280.0,4483.0,1580.0,4575.0],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"의사의 선택","tfmt":"bC","id":"o108","mmParent":"o104","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[890.0,4460.0,1190.0,4522.0],"color":"#1565C0","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"용서가 아니라 의사라서 수술한다","id":"o109","mmParent":"o108","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[890.0,4536.0,1190.0,4598.0],"color":"#1565C0","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"감정과 치료를 분리","id":"o110","mmParent":"o108","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[2220.0,4281.0,2520.0,4373.0],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"진실과 은폐","tfmt":"bC","id":"o111","mmParent":"o104","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[2610.0,4258.0,2910.0,4320.0],"color":"#6A1B9A","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"병원 안의 비리와 배후","id":"o112","mmParent":"o111","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[2610.0,4334.0,2910.0,4396.0],"color":"#6A1B9A","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"숨긴 사실이 낳은 상처","id":"o113","mmParent":"o111","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[2220.0,4483.0,2520.0,4575.0],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"죄와 대가","tfmt":"bC","id":"o114","mmParent":"o104","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[2610.0,4460.0,2910.0,4522.0],"color":"#B8860B","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"과거의 범죄가 부른 연쇄","id":"o115","mmParent":"o114","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[2610.0,4536.0,2910.0,4598.0],"color":"#B8860B","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"체포와 자수","id":"o116","mmParent":"o114","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[1750.0,4608.0,2050.0,4700.0],"color":"#455A64","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"남은 질문","tfmt":"bC","id":"o117","mmParent":"o104","mmSide":"d"},{"kind":"stroke","tool":"rect","points":[1750.0,4750.0,2050.0,4812.0],"color":"#455A64","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"이수형의 생사","id":"o118","mmParent":"o117","mmSide":"d"}],"blobs":{"hero_mc":"","p_mom":"","p_bro":"","p_tae":"","p_se":"","p_suk":"","p_dong":"","p_soo":"","s_forest":"","p_man":"","p_kyung":"","s_lake":"","s_room":"","p_chi":"","p_jung":"","p_myung":"","s_hosp":"","s_alarm":"","p_jang":"","p_choi":"","p_oh":"","s_phone":""}}