tation":0,"id":"o72"},{"kind":"list","text":"{\"title\": \"3부작 흐름\", \"items\": [\"1부 반지 원정대: 원정대가 모이고 흩어진다\", \"2부 두 개의 탑: 로한의 전투, 프로도와 골룸의 여정\", \"3부 왕의 귀환: 곤도르의 전쟁, 반지의 파괴\"]}","x":2080,"y":2508,"w":560,"h":160,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o73"},{"kind":"link","url":"https://en.wikipedia.org/wiki/The_Lord_of_the_Rings_(film_series)","x":2700,"y":2508,"w":300,"h":76,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o74"},{"kind":"text","text":"주요 장소","x":60,"y":2978,"w":1000,"h":0,"fontSize":30,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o75"},{"kind":"image","hash":"shire","x":60,"y":3038,"w":320,"h":200,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o76"},{"kind":"text","text":"샤이어 — 호빗들의 평화로운 고향","x":60,"y":3250,"w":320,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o77"},{"kind":"image","hash":"minas_tirith","x":400,"y":3038,"w":320,"h":200,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o78"},{"kind":"text","text":"미나스 티리스 — 곤도르의 흰 성벽 도시","x":400,"y":3250,"w":320,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o79"},{"kind":"image","hash":"mount_doom","x":740,"y":3038,"w":320,"h":200,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o80"},{"kind":"text","text":"운명의 산 — 반지가 만들어지고 파괴되는 곳","x":740,"y":3250,"w":320,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o81"},{"kind":"text","text":"영화 예고편 (Warner Bros. Entertainment 공식 채널)","x":1120,"y":2978,"w":1300,"h":0,"fontSize":30,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o82"},{"kind":"link","url":"https://www.youtube.com/watch?v=_nZdmwHrcnw","x":1120,"y":3038,"w":356,"h":200,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o83"},{"kind":"text","text":"1부 반지 원정대 · 카드를 고른 뒤 다시 누르면 재생","x":1120,"y":3250,"w":356,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o84"},{"kind":"link","url":"https://www.youtube.com/watch?v=nuTU5XcZTLA","x":1500,"y":3038,"w":356,"h":200,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o85"},{"kind":"text","text":"2부 두 개의 탑 · 카드를 고른 뒤 다시 누르면 재생","x":1500,"y":3250,"w":356,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o86"},{"kind":"link","url":"https://www.youtube.com/watch?v=zckJCxYxn1g","x":1880,"y":3038,"w":356,"h":200,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o87"},{"kind":"text","text":"3부 왕의 귀환 · 카드를 고른 뒤 다시 누르면 재생","x":1880,"y":3250,"w":356,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o88"},{"kind":"text","text":"보는 법: 인물 카드를 옮기면 붙은 선과 선 위 설명이 따라와요 · 선 위 설명 상자를 끌어 자리 바꾸기 · 돋보기로 이름 찾기","x":2700,"y":2608,"w":360,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#E0F7FA","width":3,"tool":"","rotation":0,"id":"o89"},{"kind":"text","text":"💍","x":3080,"y":2518,"w":80,"h":0,"fontSize":48,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o90"},{"kind":"text","text":"🗡️","x":3150,"y":2518,"w":80,"h":0,"fontSize":48,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o91"},{"kind":"text","text":"전체 스토리 라인 — 시간 순서로","x":60,"y":3368,"w":2400,"h":0,"fontSize":34,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o92"},{"kind":"text","text":"원정대가 흩어진 뒤 이야기는 두 갈래로 나뉜다: 위쪽 = 프로도·샘(반지를 옮기는 길), 아래쪽 = 나머지 원정대와 전쟁. 번호는 일어난 순서","x":60,"y":3422,"w":3000,"h":0,"fontSize":18,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o93"},{"kind":"text","text":"앞 이야기","x":74,"y":3478,"w":360,"h":0,"fontSize":22,"color":"#78909C","width":3,"tool":"","rotation":0,"id":"o94"},{"kind":"stroke","tool":"line","points":[275,3478,275,4258],"color":"#B0BEC5","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dot","headSize":"m","id":"o95"},{"kind":"text","text":"1부 반지 원정대","x":289,"y":3478,"w":360,"h":0,"fontSize":22,"color":"#B8860B","width":3,"tool":"","rotation":0,"id":"o96"},{"kind":"stroke","tool":"line","points":[1325,3478,1325,4258],"color":"#B0BEC5","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dot","headSize":"m","id":"o97"},{"kind":"text","text":"2부 두 개의 탑","x":1339,"y":3478,"w":360,"h":0,"fontSize":22,"color":"#1565C0","width":3,"tool":"","rotation":0,"id":"o98"},{"kind":"stroke","tool":"line","points":[2225,3478,2225,4258],"color":"#B0BEC5","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dot","headSize":"m","id":"o99"},{"kind":"text","text":"3부 왕의 귀환","x":2239,"y":3478,"w":360,"h":0,"fontSize":22,"color":"#C62828","width":3,"tool":"","rotation":0,"id":"o100"},{"kind":"stroke","tool":"arrow","points":[60,3838,3420,3838],"color":"#37474F","width":7,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"l","headEnd":"triangle","id":"o101"},{"kind":"text","text":"0. 먼 옛날\n사우론이 절대반지를 만든다. 이실두르가 빼앗았다가 잃고, 수천 년 뒤 골룸을 거쳐 빌보의 손에 들어간다","x":60,"y":3538,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#ECEFF1","width":3,"tool":"","rotation":0,"id":"o102"},{"kind":"stroke","tool":"line","points":[200,3838,200,3728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o103"},{"kind":"stroke","tool":"ellipse","points":[189,3827,211,3849],"color":"#78909C","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o104"},{"kind":"text","text":"1. 빌보의 생일 잔치\n빌보가 샤이어를 떠나며 반지를 조카 프로도에게 남긴다","x":210,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o105"},{"kind":"stroke","tool":"line","points":[350,3838,350,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o106"},{"kind":"stroke","tool":"ellipse","points":[339,3827,361,3849],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o107"},{"kind":"text","text":"2. 샤이어를 떠나다\n간달프가 반지의 정체를 알아내고, 프로도와 샘(메리·피핀도)이 검은 기사들에게 쫓기며 길을 나선다","x":360,"y":3538,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0,"id":"o108"},{"kind":"stroke","tool":"line","points":[500,3838,500,3728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o109"},{"kind":"stroke","tool":"ellipse","points":[489,3827,511,3849],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o110"},{"kind":"text","text":"3. 브리와 바람마루\n성큼걸이(아라곤)를 만난다. 나즈굴의 칼에 프로도가 크게 다친다","x":510,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o111"},{"kind":"stroke","tool":"line","points":[650,3838,650,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o112"},{"kind":"stroke","tool":"ellipse","points":[639,3827,661,3849],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o113"},{"kind":"text","text":"4. 깊은골 엘론드 회의\n반지를 운명의 산에서 없애기로 하고, 아홉 명의 반지 원정대가 꾸려진다","x":660,"y":3538,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o114"},{"kind":"stroke","tool":"line","points":[800,3838,800,3728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o115"},{"kind":"stroke","tool":"ellipse","points":[789,3827,811,3849],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o116"},{"kind":"text","text":"5. 모리아\n어둠에 잠긴 드워프 왕국을 지나다 발로그와 맞선 간달프가 깊은 곳으로 떨어진다","x":810,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o117"},{"kind":"stroke","tool":"line","points":[950,3838,950,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o118"},{"kind":"stroke","tool":"ellipse","points":[939,3827,961,3849],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o119"},{"kind":"text","text":"6. 로슬로리엔\n갈라드리엘에게 위로와 선물을 받고 강을 따라 내려간다","x":960,"y":3538,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o120"},{"kind":"stroke","tool":"line","points":[1100,3838,1100,3728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o121"},{"kind":"stroke","tool":"ellipse","points":[1089,3827,1111,3849],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o122"},{"kind":"text","text":"7. 아몬 헨 — 원정대가 흩어짐\n보로미르가 반지에 흔들렸다가 메리·피핀을 지키다 숨진다. 프로도와 샘은 둘만 떠난다","x":1110,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o123"},{"kind":"stroke","tool":"line","points":[1250,3838,1250,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o124"},{"kind":"stroke","tool":"ellipse","points":[1239,3827,1261,3849],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o125"},{"kind":"text","text":"8. 골룸이 길잡이로\n프로도와 샘이 뒤따르던 골룸을 붙잡아 모르도르 길잡이로 삼는다","x":1260,"y":3538,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0,"id":"o126"},{"kind":"stroke","tool":"line","points":[1400,3838,1400,3728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o127"},{"kind":"stroke","tool":"ellipse","points":[1389,3827,1411,3849],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o128"},{"kind":"text","text":"9. 로한으로\n아라곤·레골라스·김리가 잡혀간 호빗들을 쫓다 백색으로 돌아온 간달프를 만나고, 세오덴 왕을 깨운다","x":1410,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0,"id":"o129"},{"kind":"stroke","tool":"line","points":[1550,3838,1550,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o130"},{"kind":"stroke","tool":"ellipse","points":[1539,3827,1561,3849],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o131"},{"kind":"text","text":"10. 이실리엔\n파라미르가 반지의 유혹을 이겨 내고 프로도 일행을 놓아준다","x":1560,"y":3538,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0,"id":"o132"},{"kind":"stroke","tool":"line","points":[1700,3838,1700,3728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o133"},{"kind":"stroke","tool":"ellipse","points":[1689,3827,1711,3849],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o134"},{"kind":"text","text":"11. 엔트와 아이센가드\n메리와 피핀이 나무 거인 엔트들을 움직여 사루만의 아이센가드를 무너뜨린다","x":1710,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0,"id":"o135"},{"kind":"stroke","tool":"line","points":[1850,3838,1850,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o136"},{"kind":"stroke","tool":"ellipse","points":[1839,3827,1861,3849],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o137"},{"kind":"text","text":"12. 헬름협곡 전투\n로한이 사루만의 우루크하이 대군을 막아 낸다","x":2010,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0,"id":"o138"},{"kind":"stroke","tool":"line","points":[2150,3838,2150,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o139"},{"kind":"stroke","tool":"ellipse","points":[2139,3827,2161,3849],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o140"},{"kind":"text","text":"13. 키리스 웅골\n골룸의 꾀로 거대 거미 쉴롭에게 프로도가 쓰러지고, 샘이 반지를 맡았다가 프로도를 구해 낸다","x":2160,"y":3538,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0,"id":"o141"},{"kind":"stroke","tool":"line","points":[2300,3838,2300,3728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o142"},{"kind":"stroke","tool":"ellipse","points":[2289,3827,2311,3849],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o143"},{"kind":"text","text":"14. 펠렌노르 평원 전투\n미나스 티리스가 포위된다. 로한 기병이 달려오고 에오윈이 나즈굴의 왕을 쓰러뜨린다. 아라곤이 망자의 군대를 이끌고 온다","x":2310,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0,"id":"o144"},{"kind":"stroke","tool":"line","points":[2450,3838,2450,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o145"},{"kind":"stroke","tool":"ellipse","points":[2439,3827,2461,3849],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o146"},{"kind":"text","text":"15. 검은 문 앞에서\n아라곤이 남은 군대로 모르도르의 문 앞에 서서 사우론의 눈을 프로도에게서 돌린다","x":2610,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0,"id":"o147"},{"kind":"stroke","tool":"line","points":[2750,3838,2750,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o148"},{"kind":"stroke","tool":"ellipse","points":[2739,3827,2761,3849],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o149"},{"kind":"text","text":"16. 운명의 산\n마지막 순간 프로도가 반지에 넘어가지만, 반지를 빼앗은 골룸이 반지와 함께 불속으로 떨어진다. 사우론이 무너진다","x":2760,"y":3538,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0,"id":"o150"},{"kind":"stroke","tool":"line","points":[2900,3838,2900,3728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o151"},{"kind":"stroke","tool":"ellipse","points":[2889,3827,2911,3849],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o152"},{"kind":"text","text":"17. 왕의 귀환\n아라곤이 곤도르의 왕이 되어 아르웬과 결혼하고, 호빗들은 고향으로 돌아간다","x":2910,"y":3918,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o153"},{"kind":"stroke","tool":"line","points":[3050,3838,3050,3918],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o154"},{"kind":"stroke","tool":"ellipse","points":[3039,3827,3061,3849],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o155"},{"kind":"text","text":"18. 회색 항구\n프로도는 빌보·간달프와 함께 바다 건너로 떠나고, 샘은 샤이어에서 가정을 꾸린다","x":3060,"y":3538,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o156"},{"kind":"stroke","tool":"line","points":[3200,3838,3200,3728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o157"},{"kind":"stroke","tool":"ellipse","points":[3189,3827,3211,3849],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o158"},{"kind":"stroke","tool":"rect","points":[1130,4128,1450,4198],"color":"#C62828","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"여기서 이야기가 두 갈래로","id":"o159"},{"kind":"text","text":"색 보기","x":60,"y":4288,"w":200,"h":0,"fontSize":20,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o160"},{"kind":"stroke","tool":"rect","points":[200,4288,240,4318],"color":"#B8860B","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFF3B0","id":"o161"},{"kind":"text","text":"원정대 전체·결말","x":252,"y":4290,"w":240,"h":0,"fontSize":17,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o162"},{"kind":"stroke","tool":"rect","points":[500,4288,540,4318],"color":"#2E7D32","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#E3F4E1","id":"o163"},{"kind":"text","text":"프로도·샘의 길","x":552,"y":4290,"w":240,"h":0,"fontSize":17,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o164"},{"kind":"stroke","tool":"rect","points":[800,4288,840,4318],"color":"#1565C0","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#DCEBFF","id":"o165"},{"kind":"text","text":"나머지 원정대와 전쟁","x":852,"y":4290,"w":240,"h":0,"fontSize":17,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o166"},{"kind":"stroke","tool":"rect","points":[1100,4288,1140,4318],"color":"#78909C","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#ECEFF1","id":"o167"},{"kind":"text","text":"앞 이야기","x":1152,"y":4290,"w":240,"h":0,"fontSize":17,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o168"},{"kind":"text","text":"큰 주제 — 마인드맵","x":60,"y":4448,"w":2400,"h":0,"fontSize":34,"color":"#1A1D26","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o169"},{"kind":"text","text":"가지를 고르고 Space로 접고 펴요. Tab으로 하위 가지, Enter로 같은 단계 가지를 더해 나만의 해석을 넓혀 보세요","x":60,"y":4502,"w":1900,"h":0,"fontSize":18,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o170"},{"kind":"stroke","tool":"rect","points":[900.0,4888.0,1260.0,5008.0],"color":"#B8860B","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":26,"rotation":0,"bg":"#FFF3D6","text":"반지의 제왕\n큰 주제","font":"serif","tfmt":"bC","id":"o171","mmRoot":true},{"kind":"stroke","tool":"rect","points":[1400.0,4801.0,1700.0,4893.0],"color":"#C62828","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"권력과 유혹","tfmt":"bC","id":"o172","mmParent":"o171","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[1790.0,4778.0,2090.0,4840.0],"color":"#C62828","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"반지는 가진 이를 서서히 바꾼다","id":"o173","mmParent":"o172","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[1790.0,4854.0,2090.0,4916.0],"color":"#C62828","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"보로미르·골룸·사루만","id":"o174","mmParent":"o172","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[1400.0,5003.0,1700.0,5095.0],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"우정과 연대","tfmt":"bC","id":"o175","mmParent":"o171","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[1790.0,4980.0,2090.0,5042.0],"color":"#2E7D32","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"프로도와 샘","id":"o176","mmParent":"o175","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[1790.0,5056.0,2090.0,5118.0],"color":"#2E7D32","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"레골라스와 김리","id":"o177","mmParent":"o175","mmSide":"r"},{"kind":"stroke","tool":"rect","points":[460.0,4801.0,760.0,4893.0],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"희생","tfmt":"bC","id":"o178","mmParent":"o171","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[70.0,4778.0,370.0,4840.0],"color":"#6A1B9A","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"간달프·보로미르의 희생","id":"o179","mmParent":"o178","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[70.0,4854.0,370.0,4916.0],"color":"#6A1B9A","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"프로도는 고향의 평화를 잃는다","id":"o180","mmParent":"o178","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[460.0,4968.0,760.0,5060.0],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"작은 이의 용기","tfmt":"bC","id":"o181","mmParent":"o171","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[70.0,4983.0,370.0,5045.0],"color":"#B8860B","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"호빗이 세상을 구한다","id":"o182","mmParent":"o181","mmSide":"l"},{"kind":"stroke","tool":"rect","points":[930.0,4676.0,1230.0,4768.0],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":20,"rotation":0,"bg":"#FFFFFF","text":"희망","tfmt":"bC","id":"o183","mmParent":"o171","mmSide":"u"},{"kind":"stroke","tool":"rect","points":[930.0,4564.0,1230.0,4626.0],"color":"#1565C0","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"아라곤의 귀환","id":"o184","mmParent":"o183","mmSide":"u"},{"kind":"text","text":"반지 원정대 9명의 종족 구성","x":2100,"y":4448,"w":1400,"h":0,"fontSize":34,"color":"#1A1D26","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o185"},{"kind":"table","text":"{\"rows\": 6, \"cols\": 2, \"cells\": [\"종족\", \"원정대 인원\", \"호빗\", \"4\", \"인간\", \"2\", \"요정\", \"1\", \"드워프\", \"1\", \"마법사\", \"1\"]}","x":2100,"y":4528,"w":560,"h":264,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o186"},{"kind":"chart","text":"{\"src\": \"o186\", \"type\": \"pie\", \"byRow\": false, \"labels\": true, \"legend\": true, \"title\": \"원정대 9명\"}","x":2720,"y":4528,"w":760,"h":460,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o187"},{"kind":"text","text":"그래프는 왼쪽 표의 숫자로 그려요 — 표의 숫자를 고치면 그래프도 바로 바뀌어요","x":2100,"y":5048,"w":1380,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o188"}],"blobs":{"hero_lotr":"","hobbit":"","face_frodo":"","face_sam":"","men":"","face_aragorn":"","wizard":"","face_gandalf":"","face_saruman":"","ring":"","elf":"","face_legolas":"","dwarf":"","face_gimli":"","dark":"","face_gollum":"","shire":"","minas_tirith":"","mount_doom":""}}