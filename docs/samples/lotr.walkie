dash":"dashdot","headSize":"m","headStart":"open","headEnd":"open"},{"kind":"text","text":"요정의 반지 · 지혜와 도움(엘론드 회의)","x":2120,"y":640,"w":360,"h":0,"fontSize":16,"color":"#7B1FA2","width":3,"tool":"","rotation":0},{"kind":"text","text":"한눈에 보기","x":60,"y":1760,"w":1500,"h":0,"fontSize":30,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"table","text":"{\"rows\": 7, \"cols\": 4, \"cells\": [\"종족\", \"대표 인물\", \"근거지\", \"반지와의 관계\", \"호빗\", \"프로도 · 샘\", \"샤이어\", \"반지를 운반해 파괴\", \"인간\", \"아라곤 · 보로미르\", \"곤도르 · 로한\", \"유혹에 흔들리지만 맞섬\", \"요정\", \"레골라스 · 엘론드\", \"깊은골 · 로슬로리엔\", \"세 반지의 주인, 반지 파괴를 지지\", \"드워프\", \"김리\", \"외로운 산 · 모리아\", \"일곱 반지(옛 이야기)\", \"마법사\", \"간달프 · 사루만\", \"아이센가드 등\", \"간달프는 거절, 사루만은 탐함\", \"어둠의 세력\", \"사우론 · 나즈굴\", \"모르도르\", \"반지를 되찾으려 함\"]}","x":60,"y":1820,"w":1500,"h":308,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"list","text":"{\"title\": \"반지 원정대 9명\", \"items\": [\"프로도\", \"샘\", \"메리\", \"피핀\", \"간달프\", \"아라곤\", \"보로미르\", \"레골라스\", \"김리\"]}","x":1620,"y":1820,"w":400,"h":400,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"list","text":"{\"title\": \"3부작 흐름\", \"items\": [\"1부 반지 원정대: 원정대가 모이고 흩어진다\", \"2부 두 개의 탑: 로한의 전투, 프로도와 골룸의 여정\", \"3부 왕의 귀환: 곤도르의 전쟁, 반지의 파괴\"]}","x":2080,"y":1820,"w":560,"h":160,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"link","url":"https://en.wikipedia.org/wiki/The_Lord_of_the_Rings_(film_series)","x":2700,"y":1820,"w":300,"h":76,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"text","text":"주요 장소","x":60,"y":2290,"w":1000,"h":0,"fontSize":30,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"image","hash":"shire","x":60,"y":2350,"w":320,"h":200,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20},{"kind":"text","text":"샤이어 — 호빗들의 평화로운 고향","x":60,"y":2562,"w":320,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"image","hash":"minas_tirith","x":400,"y":2350,"w":320,"h":200,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20},{"kind":"text","text":"미나스 티리스 — 곤도르의 흰 성벽 도시","x":400,"y":2562,"w":320,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"image","hash":"mount_doom","x":740,"y":2350,"w":320,"h":200,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20},{"kind":"text","text":"운명의 산 — 반지가 만들어지고 파괴되는 곳","x":740,"y":2562,"w":320,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"text","text":"영화 예고편 (Warner Bros. Entertainment 공식 채널)","x":1120,"y":2290,"w":1300,"h":0,"fontSize":30,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"link","url":"https://www.youtube.com/watch?v=_nZdmwHrcnw","x":1120,"y":2350,"w":356,"h":200,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"text","text":"1부 반지 원정대 · 카드를 고른 뒤 다시 누르면 재생","x":1120,"y":2562,"w":356,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"link","url":"https://www.youtube.com/watch?v=nuTU5XcZTLA","x":1500,"y":2350,"w":356,"h":200,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"text","text":"2부 두 개의 탑 · 카드를 고른 뒤 다시 누르면 재생","x":1500,"y":2562,"w":356,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"link","url":"https://www.youtube.com/watch?v=zckJCxYxn1g","x":1880,"y":2350,"w":356,"h":200,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"text","text":"3부 왕의 귀환 · 카드를 고른 뒤 다시 누르면 재생","x":1880,"y":2562,"w":356,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"text","text":"보는 법: 선을 두 번 누르면 서식, 카드를 누르면 누가 만들었는지, 돋보기로 이름 찾기","x":2700,"y":1920,"w":360,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#E0F7FA","width":3,"tool":"","rotation":0},{"kind":"text","text":"💍","x":3080,"y":1830,"w":80,"h":0,"fontSize":48,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"text","text":"🗡️","x":3150,"y":1830,"w":80,"h":0,"fontSize":48,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"text","text":"전체 스토리 라인 — 시간 순서로","x":60,"y":2680,"w":2400,"h":0,"fontSize":34,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"text","text":"원정대가 흩어진 뒤 이야기는 두 갈래로 나뉜다: 위쪽 = 프로도·샘(반지를 옮기는 길), 아래쪽 = 나머지 원정대와 전쟁. 번호는 일어난 순서","x":60,"y":2734,"w":3000,"h":0,"fontSize":18,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"text","text":"앞 이야기","x":74,"y":2790,"w":360,"h":0,"fontSize":22,"color":"#78909C","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[275,2790,275,3570],"color":"#B0BEC5","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dot","headSize":"m"},{"kind":"text","text":"1부 반지 원정대","x":289,"y":2790,"w":360,"h":0,"fontSize":22,"color":"#B8860B","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[1325,2790,1325,3570],"color":"#B0BEC5","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dot","headSize":"m"},{"kind":"text","text":"2부 두 개의 탑","x":1339,"y":2790,"w":360,"h":0,"fontSize":22,"color":"#1565C0","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[2225,2790,2225,3570],"color":"#B0BEC5","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dot","headSize":"m"},{"kind":"text","text":"3부 왕의 귀환","x":2239,"y":2790,"w":360,"h":0,"fontSize":22,"color":"#C62828","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"arrow","points":[60,3150,3420,3150],"color":"#37474F","width":7,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"l","headEnd":"triangle"},{"kind":"text","text":"0. 먼 옛날\n사우론이 절대반지를 만든다. 이실두르가 빼앗았다가 잃고, 수천 년 뒤 골룸을 거쳐 빌보의 손에 들어간다","x":60,"y":2850,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#ECEFF1","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[200,3150,200,3040],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[189,3139,211,3161],"color":"#78909C","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"1. 빌보의 생일 잔치\n빌보가 샤이어를 떠나며 반지를 조카 프로도에게 남긴다","x":210,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[350,3150,350,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[339,3139,361,3161],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"2. 샤이어를 떠나다\n간달프가 반지의 정체를 알아내고, 프로도와 샘(메리·피핀도)이 검은 기사들에게 쫓기며 길을 나선다","x":360,"y":2850,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[500,3150,500,3040],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[489,3139,511,3161],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"3. 브리와 바람마루\n성큼걸이(아라곤)를 만난다. 나즈굴의 칼에 프로도가 크게 다친다","x":510,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[650,3150,650,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[639,3139,661,3161],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"4. 깊은골 엘론드 회의\n반지를 운명의 산에서 없애기로 하고, 아홉 명의 반지 원정대가 꾸려진다","x":660,"y":2850,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[800,3150,800,3040],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[789,3139,811,3161],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"5. 모리아\n어둠에 잠긴 드워프 왕국을 지나다 발로그와 맞선 간달프가 깊은 곳으로 떨어진다","x":810,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[950,3150,950,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[939,3139,961,3161],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"6. 로슬로리엔\n갈라드리엘에게 위로와 선물을 받고 강을 따라 내려간다","x":960,"y":2850,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[1100,3150,1100,3040],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[1089,3139,1111,3161],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"7. 아몬 헨 — 원정대가 흩어짐\n보로미르가 반지에 흔들렸다가 메리·피핀을 지키다 숨진다. 프로도와 샘은 둘만 떠난다","x":1110,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[1250,3150,1250,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[1239,3139,1261,3161],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"8. 골룸이 길잡이로\n프로도와 샘이 뒤따르던 골룸을 붙잡아 모르도르 길잡이로 삼는다","x":1260,"y":2850,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[1400,3150,1400,3040],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[1389,3139,1411,3161],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"9. 로한으로\n아라곤·레골라스·김리가 잡혀간 호빗들을 쫓다 백색으로 돌아온 간달프를 만나고, 세오덴 왕을 깨운다","x":1410,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[1550,3150,1550,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[1539,3139,1561,3161],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"10. 이실리엔\n파라미르가 반지의 유혹을 이겨 내고 프로도 일행을 놓아준다","x":1560,"y":2850,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[1700,3150,1700,3040],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[1689,3139,1711,3161],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"11. 엔트와 아이센가드\n메리와 피핀이 나무 거인 엔트들을 움직여 사루만의 아이센가드를 무너뜨린다","x":1710,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[1850,3150,1850,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[1839,3139,1861,3161],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"12. 헬름협곡 전투\n로한이 사루만의 우루크하이 대군을 막아 낸다","x":2010,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[2150,3150,2150,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[2139,3139,2161,3161],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"13. 키리스 웅골\n골룸의 꾀로 거대 거미 쉴롭에게 프로도가 쓰러지고, 샘이 반지를 맡았다가 프로도를 구해 낸다","x":2160,"y":2850,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[2300,3150,2300,3040],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[2289,3139,2311,3161],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"14. 펠렌노르 평원 전투\n미나스 티리스가 포위된다. 로한 기병이 달려오고 에오윈이 나즈굴의 왕을 쓰러뜨린다. 아라곤이 망자의 군대를 이끌고 온다","x":2310,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[2450,3150,2450,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[2439,3139,2461,3161],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"15. 검은 문 앞에서\n아라곤이 남은 군대로 모르도르의 문 앞에 서서 사우론의 눈을 프로도에게서 돌린다","x":2610,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#DCEBFF","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[2750,3150,2750,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[2739,3139,2761,3161],"color":"#1565C0","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"16. 운명의 산\n마지막 순간 프로도가 반지에 넘어가지만, 반지를 빼앗은 골룸이 반지와 함께 불속으로 떨어진다. 사우론이 무너진다","x":2760,"y":2850,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#E3F4E1","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[2900,3150,2900,3040],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[2889,3139,2911,3161],"color":"#2E7D32","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"17. 왕의 귀환\n아라곤이 곤도르의 왕이 되어 아르웬과 결혼하고, 호빗들은 고향으로 돌아간다","x":2910,"y":3230,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[3050,3150,3050,3230],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[3039,3139,3061,3161],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"text","text":"18. 회색 항구\n프로도는 빌보·간달프와 함께 바다 건너로 떠나고, 샘은 샤이어에서 가정을 꾸린다","x":3060,"y":2850,"w":280,"h":0,"fontSize":14,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[3200,3150,3200,3040],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"stroke","tool":"ellipse","points":[3189,3139,3211,3161],"color":"#B8860B","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF"},{"kind":"stroke","tool":"rect","points":[1130,3440,1450,3510],"color":"#C62828","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#FFFFFF","text":"여기서 이야기가 두 갈래로"},{"kind":"text","text":"색 보기","x":60,"y":3600,"w":200,"h":0,"fontSize":20,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"rect","points":[200,3600,240,3630],"color":"#B8860B","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFF3B0"},{"kind":"text","text":"원정대 전체·결말","x":252,"y":3602,"w":240,"h":0,"fontSize":17,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"rect","points":[500,3600,540,3630],"color":"#2E7D32","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#E3F4E1"},{"kind":"text","text":"프로도·샘의 길","x":552,"y":3602,"w":240,"h":0,"fontSize":17,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"rect","points":[800,3600,840,3630],"color":"#1565C0","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#DCEBFF"},{"kind":"text","text":"나머지 원정대와 전쟁","x":852,"y":3602,"w":240,"h":0,"fontSize":17,"color":"#1A1D26","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"rect","points":[1100,3600,1140,3630],"color":"#78909C","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#ECEFF1"},{"kind":"text","text":"앞 이야기","x":1152,"y":3602,"w":240,"h":0,"fontSize":17,"color":"#1A1D26","width":3,"tool":"","rotation":0}],"blobs":{"hobbit":"","face_frodo":"","face_sam":"","men":"","face_aragorn":"","wizard":"","face_gandalf":"","face_saruman":"","ring":"","elf":"","face_legolas":"","dwarf":"","face_gimli":"","dark":"","face_gollum":"","shire":"","minas_tirith":"","mount_doom":""}}