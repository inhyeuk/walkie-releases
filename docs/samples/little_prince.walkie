{"format":"walkie-board-backup","v":1,"created":"2026-10-31T09:00:00+00:00","board":"어린 왕자 · 스토리 라인","objects":[{"kind":"image","hash":"hero_prince","x":40,"y":20,"w":3560,"h":760,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o1"},{"kind":"text","text":"어린 왕자 — 스토리 라인","x":110,"y":520,"w":3420,"h":0,"fontSize":72,"color":"#FFFFFF","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o2"},{"kind":"text","text":"앙투안 드 생텍쥐페리, 1943 · 줄거리를 직접 요약한 샘플 보드(원문 인용 없음)","x":114,"y":640,"w":3400,"h":0,"fontSize":27,"color":"#FFFFFF","width":3,"tool":"","rotation":0,"id":"o3"},{"kind":"stroke","tool":"line","points":[1000,908,1000,2328],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dot","headSize":"m","id":"o4"},{"kind":"stroke","tool":"line","points":[2420,908,2420,2328],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dot","headSize":"m","id":"o5"},{"kind":"text","text":"1부 · 사막에서의 만남","x":80,"y":908,"w":860,"h":0,"fontSize":26,"color":"#1565C0","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o6"},{"kind":"text","text":"2부 · 어린 왕자의 이야기: 작은 별과 여섯 별 여행","x":1040,"y":908,"w":1340,"h":0,"fontSize":26,"color":"#6A1B9A","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o7"},{"kind":"text","text":"3부 · 지구에서 배운 것과 이별","x":2460,"y":908,"w":1100,"h":0,"fontSize":26,"color":"#C62828","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o8"},{"kind":"stroke","tool":"arrow","points":[60,1648,3560,1648],"color":"#37474F","width":7,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"l","headEnd":"triangle","id":"o9"},{"kind":"image","hash":"plane","x":90,"y":988,"w":280,"h":175,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o10"},{"kind":"image","hash":"prince","x":740,"y":1018,"w":150,"h":150,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o11"},{"kind":"text","text":"어린 왕자","x":720,"y":1178,"w":220,"h":0,"fontSize":17,"color":"#1565C0","width":3,"tool":"","rotation":0,"id":"o12"},{"kind":"text","text":"#1 사막에 불시착\n비행기가 고장 나 비행사가 사하라 사막에 홀로 남는다","x":80,"y":1348,"w":300,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o13"},{"kind":"stroke","tool":"line","points":[230,1648,230,1518],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o14"},{"kind":"stroke","tool":"ellipse","points":[220,1638,240,1658],"color":"#37474F","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o15"},{"kind":"image","hash":"box","x":430,"y":1938,"w":120,"h":120,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o16"},{"kind":"text","text":"#2 \"양을 그려 줘\"\n이상한 꼬마가 나타나 양을 그려 달라고 한다. 구멍 뚫린 상자 그림에 오히려 기뻐한다","x":430,"y":1728,"w":300,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#FFF3B0","width":3,"tool":"","rotation":0,"id":"o17"},{"kind":"stroke","tool":"line","points":[580,1648,580,1728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o18"},{"kind":"stroke","tool":"ellipse","points":[570,1638,590,1658],"color":"#37474F","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o19"},{"kind":"image","hash":"planet","x":1060,"y":1108,"w":120,"h":120,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o20"},{"kind":"text","text":"#3 소행성 B612\n바오밥 싹 뽑기, 화산 청소, 하루에도 몇 번씩 해 지는 걸 보는 작은 별의 하루","x":1060,"y":1348,"w":300,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#F3E5F5","width":3,"tool":"","rotation":0,"id":"o21"},{"kind":"stroke","tool":"line","points":[1210,1648,1210,1518],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o22"},{"kind":"stroke","tool":"ellipse","points":[1200,1638,1220,1658],"color":"#37474F","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o23"},{"kind":"image","hash":"rose","x":1080,"y":1988,"w":110,"h":110,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o24"},{"kind":"text","text":"#4 장미와의 갈등\n아름답지만 까다로운 장미에게 상처받고, 별을 떠나 여행길에 오른다","x":1200,"y":1728,"w":300,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#F3E5F5","width":3,"tool":"","rotation":0,"id":"o25"},{"kind":"stroke","tool":"line","points":[1350,1648,1350,1728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o26"},{"kind":"stroke","tool":"ellipse","points":[1340,1638,1360,1658],"color":"#37474F","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o27"},{"kind":"stroke","tool":"ellipse","points":[1560,1118,1688,1246],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#EDE7F6","text":"왕","id":"o28"},{"kind":"stroke","tool":"ellipse","points":[1700,1158,1828,1286],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#EDE7F6","text":"허영쟁이","id":"o29"},{"kind":"stroke","tool":"ellipse","points":[1840,1118,1968,1246],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#EDE7F6","text":"술꾼","id":"o30"},{"kind":"stroke","tool":"ellipse","points":[1980,1158,2108,1286],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#EDE7F6","text":"사업가","id":"o31"},{"kind":"stroke","tool":"ellipse","points":[2120,1118,2248,1246],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#EDE7F6","text":"가로등지기","id":"o32"},{"kind":"stroke","tool":"ellipse","points":[2260,1158,2388,1286],"color":"#6A1B9A","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":16,"rotation":0,"bg":"#EDE7F6","text":"지리학자","id":"o33"},{"kind":"stroke","tool":"rect","points":[1560,1328,2390,1528],"color":"#6A1B9A","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":14,"rotation":0,"bg":"#F3E5F5","text":"#5 여섯 별 여행 — 어른들의 이상한 모습\n왕: 명령하고 싶은 사람  ·  허영쟁이: 칭찬만 듣고 싶은 사람  ·  술꾼: 부끄러움을 잊으려 마시는 사람\n사업가: 별을 세며 가졌다고 믿는 사람  ·  가로등지기: 쉴 틈 없이 약속을 지키는 사람  ·  지리학자: 직접 가 보지 않고 책상에서 기록하는 사람","id":"o34"},{"kind":"stroke","tool":"line","points":[1975,1528,1975,1648],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o35"},{"kind":"stroke","tool":"rect","points":[1700,1768,2340,1888],"color":"#6A1B9A","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":15,"rotation":0,"bg":"#F8E1FF","text":"가로등지기만은 자기 일이 아닌 다른 것을 위해 일한다\n어린 왕자가 친구로 삼고 싶었던 단 한 사람","id":"o36"},{"kind":"image","hash":"snake","x":2470,"y":1108,"w":110,"h":110,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o37"},{"kind":"text","text":"#6 지구에 도착\n사막에서 뱀을 만난다. 장미 정원에서 자기 장미가 흔한 꽃이었음을 알고 운다","x":2470,"y":1348,"w":300,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#FFEBEE","width":3,"tool":"","rotation":0,"id":"o38"},{"kind":"stroke","tool":"line","points":[2620,1648,2620,1518],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o39"},{"kind":"stroke","tool":"ellipse","points":[2610,1638,2630,1658],"color":"#37474F","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o40"},{"kind":"image","hash":"fox","x":2470,"y":2028,"w":120,"h":120,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o41"},{"kind":"text","text":"#7 여우와 \"길들이기\"\n시간을 들여 정을 쌓은 것은 세상에 하나뿐인 것이 된다 — 그래서 내 장미가 소중하다는 걸 깨닫는다","x":2600,"y":1728,"w":300,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#FFEBEE","width":3,"tool":"","rotation":0,"id":"o42"},{"kind":"stroke","tool":"line","points":[2750,1648,2750,1728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o43"},{"kind":"stroke","tool":"ellipse","points":[2740,1638,2760,1658],"color":"#37474F","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o44"},{"kind":"image","hash":"well","x":2860,"y":1128,"w":210,"h":131,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o45"},{"kind":"text","text":"#8 우물\n갈증 속에 비행사와 함께 걸어 사막에서 우물을 찾는다","x":2860,"y":1348,"w":300,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#FFEBEE","width":3,"tool":"","rotation":0,"id":"o46"},{"kind":"stroke","tool":"line","points":[3010,1648,3010,1518],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o47"},{"kind":"stroke","tool":"ellipse","points":[3000,1638,3020,1658],"color":"#37474F","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o48"},{"kind":"text","text":"#9 떠남\n도착한 지 1년 되는 날, 뱀의 도움으로 자기 별로 돌아간다","x":3000,"y":1728,"w":300,"h":0,"fontSize":16,"color":"#1A1D26","bg":"#FFEBEE","width":3,"tool":"","rotation":0,"id":"o49"},{"kind":"stroke","tool":"line","points":[3150,1648,3150,1728],"color":"#90A4AE","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"id":"o50"},{"kind":"stroke","tool":"ellipse","points":[3140,1638,3160,1658],"color":"#37474F","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFFFFF","id":"o51"},{"kind":"image","hash":"star","x":3320,"y":1248,"w":120,"h":120,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"id":"o52"},{"kind":"text","text":"#10 별을 바라보는 비행사\n비행기를 고쳐 돌아온 뒤, 밤하늘의 별을 보며 어린 왕자를 떠올린다","x":3260,"y":1388,"w":300,"h":0,"fontSize":15,"color":"#1A1D26","bg":"#E3F2FD","width":3,"tool":"","rotation":0,"id":"o53"},{"kind":"text","text":"인물과 의미","x":60,"y":2388,"w":1400,"h":0,"fontSize":30,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o54"},{"kind":"table","text":"{\"rows\": 7, \"cols\": 3, \"cells\": [\"인물\", \"만난 곳\", \"이야기 속 의미\", \"비행사(나)\", \"사하라 사막\", \"어른이 되며 잊은 것을 다시 떠올림\", \"어린 왕자\", \"소행성 B612\", \"어른의 세계를 낯설게 바라보는 눈\", \"장미\", \"B612\", \"사랑과 책임 — 서툴러서 서로 상처를 줌\", \"여섯 별의 어른들\", \"여행한 소행성들\", \"권력·허영·도피·소유·의무·책상 지식\", \"뱀\", \"지구(사막)\", \"이별과 돌아감\", \"여우\", \"지구\", \"관계를 맺는 법, 시간과 정성\"]}","x":60,"y":2448,"w":1500,"h":308,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o55"},{"kind":"list","text":"{\"title\": \"생각해 볼 주제\", \"items\": [\"어른들은 숫자로만 세상을 본다\", \"보이지 않는 것을 마음으로 보기\", \"길들인 것에 대한 책임\", \"떠남과 그리움\"]}","x":1620,"y":2448,"w":560,"h":200,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o56"},{"kind":"list","text":"{\"title\": \"보드 활용 팁\", \"items\": [\"사건 포스트잇을 옮겨 순서를 바꿔 보기\", \"여섯 별에 나만의 해석 적기\", \"돋보기로 인물 이름 찾기\"]}","x":2240,"y":2448,"w":520,"h":160,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o57"},{"kind":"link","url":"https://en.wikipedia.org/wiki/The_Little_Prince","x":2820,"y":2448,"w":300,"h":76,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o58"},{"kind":"text","text":"애니메이션 영화 「어린 왕자」(2015, 마크 오스본 감독) 예고편 — 공식 채널","x":60,"y":2808,"w":1600,"h":0,"fontSize":28,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o59"},{"kind":"link","url":"https://www.youtube.com/watch?v=sHjd4r1SJ5c","x":60,"y":2868,"w":356,"h":200,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o60"},{"kind":"text","text":"공식 예고편 · Mediawan Kids & Family","x":60,"y":3080,"w":380,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o61"},{"kind":"link","url":"https://www.youtube.com/watch?v=jUucvKHUkNw","x":460,"y":2868,"w":356,"h":200,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o62"},{"kind":"text","text":"티저 예고편 · Lionsgate Canada","x":460,"y":3080,"w":380,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0,"id":"o63"},{"kind":"text","text":"🌹","x":2820,"y":2548,"w":80,"h":0,"fontSize":48,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o64"},{"kind":"text","text":"🦊","x":2900,"y":2548,"w":80,"h":0,"fontSize":48,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o65"},{"kind":"text","text":"⭐","x":2980,"y":2548,"w":80,"h":0,"fontSize":48,"color":"#1A1D26","width":3,"tool":"","rotation":0,"id":"o66"},{"kind":"text","text":"관계 지도 — 어린 왕자가 만난 이들","x":60,"y":3208,"w":1600,"h":0,"fontSize":34,"color":"#1A1D26","width":3,"tool