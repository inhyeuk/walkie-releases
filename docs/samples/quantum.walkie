,1815,2970],"color":"#B5452F","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dash","headSize":"m","headEnd":"triangle"},{"kind":"text","text":"경쟁하던 두 이론 → 1926년 같은 이론으로 밝혀짐","x":1030,"y":3008,"w":700,"h":0,"fontSize":15,"color":"#B5452F","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"arrow","points":[870,2975,620,3150],"color":"#14213D","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"dot","headSize":"m","headEnd":"open"},{"kind":"text","text":"논문을 읽고 독자적으로 정식화","x":700,"y":3150,"w":420,"h":0,"fontSize":15,"color":"#14213D","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"rect","points":[2200,2290,2840,2490],"color":"#14213D","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#E8ECF5","text":"행렬역학 · 1925 · 괴팅겐\n하이젠베르크·보른·요르단\n관측할 수 있는 양만으로, 행렬 계산"},{"kind":"stroke","tool":"rect","points":[2960,2290,3600,2490],"color":"#2A7F8E","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#E1F0F2","text":"파동역학 · 1926 · 취리히\n슈뢰딩거\n드브로이의 물질파를 파동방정식으로"},{"kind":"stroke","tool":"arrow","points":[2520,2490,2800,2610],"color":"#14213D","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle"},{"kind":"stroke","tool":"arrow","points":[3280,2490,3000,2610],"color":"#2A7F8E","width":4,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"m","headEnd":"triangle"},{"kind":"stroke","tool":"rect","points":[2560,2610,3240,2780],"color":"#8A6A1F","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"bg":"#FFF3D6","text":"1926 · 두 이론은 같은 것\n슈뢰딩거·파울리·에카르트, 디랙의 변환 이론"},{"kind":"stroke","tool":"arrow","points":[2900,2780,2900,2880],"color":"#14213D","width":5,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0,"dash":"solid","headSize":"l","headEnd":"triangle"},{"kind":"stroke","tool":"rect","points":[2560,2880,3240,3070],"color":"#FFFFFF","width":3,"x":0,"y":0,"w":0,"h":0,"fontSize":26,"rotation":0,"bg":"#14213D","text":"양자역학\n보른의 확률 해석 + 불확정성 원리"},{"kind":"text","text":"IV   해석 — 측정하면 무엇이 일어나는가","x":60,"y":3420,"w":3400,"h":0,"fontSize":34,"color":"#14213D","width":3,"tool":"","rotation":0},{"kind":"text","text":"이론은 놀랍도록 정확하게 맞지만, 그것이 \"무엇을 뜻하는지\"는 지금도 논쟁 중이다","x":64,"y":3474,"w":3400,"h":0,"fontSize":18,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"stroke","tool":"line","points":[60,3510,3600,3510],"color":"#B08D3C","width":2,"x":0,"y":0,"w":0,"h":0,"fontSize":18,"rotation":0},{"kind":"image","hash":"f_doubleslit","x":60,"y":3530,"w":1000,"h":700,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20},{"kind":"text","text":"이중 슬릿 — 전자 하나씩","x":60,"y":4244,"w":1000,"h":0,"fontSize":22,"color":"#14213D","width":3,"tool":"","rotation":0},{"kind":"text","text":"전자는 한 점에 하나씩 떨어지지만, 쌓이면 파동의 간섭무늬가 된다. 어느 슬릿을 지났는지 관측하면 무늬가 사라진다.","x":60,"y":4280,"w":1000,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"image","hash":"f_orbitals","x":1120,"y":3530,"w":1260,"h":538,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20},{"kind":"text","text":"수소 원자의 전자 구름 — 실제 계산","x":1120,"y":4082,"w":1260,"h":0,"fontSize":22,"color":"#14213D","width":3,"tool":"","rotation":0},{"kind":"text","text":"슈뢰딩거 방정식의 풀이 |ψ|². 밝을수록 전자를 찾을 확률이 높다(보른). 1s·2p·3d 상태의 단면.","x":1120,"y":4118,"w":1260,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"image","hash":"f_uncertainty","x":2460,"y":3530,"w":1100,"h":734,"rotation":0,"color":"#1A1D26","width":3,"tool":"","fontSize":20},{"kind":"text","text":"불확정성 원리","x":2460,"y":4278,"w":1100,"h":0,"fontSize":22,"color":"#14213D","width":3,"tool":"","rotation":0},{"kind":"text","text":"위치를 좁히면 운동량이 퍼지고, 운동량을 좁히면 위치가 퍼진다 — 측정 기술이 아니라 파동의 성질.","x":2460,"y":4314,"w":1100,"h":0,"fontSize":16,"color":"#5A6275","width":3,"tool":"","rotation":0},{"kind":"table","text":"{\"rows\": 5, \"cols\": 3, \"cells\": [\"\", \"코펜하겐(보어·하이젠베르크)\", \"아인슈타인·슈뢰딩거\", \"파동함수\", \"알 수 있는 것의 전부\", \"아직 불완전한 설명\", \"측정 전 입자의 위치\", \"정해져 있지 않음\", \"정해져 있어야 함\", \"확률\", \"자연 자체의 성질\", \"숨은 원인이 있을 것\", \"유명한 말\", \"관측이 현상을 만든다\", \"신은 주사위를 던지지 않는다\"]}","x":1120,"y":4210,"w":1260,"h":220,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"list","text":"{\"title\": \"그 뒤의 이야기 — 아직 열린 질문\", \"items\": [\"1935 · EPR 논문 — 아인슈타인이 \\\"불완전하다\\\"고 주장\", \"1935 · 슈뢰딩거의 고양이 사고실험\", \"1957 · 에버렛의 다세계 해석\", \"1964 · 벨 부등식 — 논쟁을 실험으로 가릴 수 있게 됨\", \"1982 · 아스페 실험 — 양자 얽힘을 확인\", \"2022 · 노벨 물리학상(아스페·클라우저·차일링거)\"]}","x":60,"y":4390,"w":1000,"h":280,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"list","text":"{\"title\": \"핵심 식\", \"items\": [\"E = hν — 에너지의 덩어리(플랑크)\", \"λ = h/p — 물질의 파동(드브로이)\", \"xp − px = iħ — 행렬역학의 핵심 관계\", \"iħ ∂ψ/∂t = Ĥψ — 슈뢰딩거 방정식\", \"P = |ψ|² — 보른의 확률 해석\", \"Δx · Δp ≥ ħ/2 — 불확정성 원리\"]}","x":2460,"y":4430,"w":1100,"h":280,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"text","text":"보는 법\n시간축의 포스트잇을 옮겨 나만의 연표로, 메달 사이에 선을 더 그어 관계를 보태 보세요. 돋보기로 이름·식 찾기","x":1120,"y":4470,"w":400,"h":0,"fontSize":15,"color":"#1A1D26","bg":"#FFF3D6","width":3,"tool":"","rotation":0},{"kind":"link","url":"https://en.wikipedia.org/wiki/History_of_quantum_mechanics","x":1580,"y":4470,"w":380,"h":76,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0},{"kind":"link","url":"https://en.wikipedia.org/wiki/Solvay_Conference","x":1580,"y":4570,"w":380,"h":76,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0}],"blobs":{"f_blackbody":"","f_photoelectric":"","f_spectrum":"","f_stern":"","m_planck":"","m_einstein":"","m_bohr":"","m_sommerfeld":"","m_debroglie":"","m_jordan":"","m_born":"","m_heisenberg":"","m_pauli":"","m_schrodinger":"","m_dirac":"","f_doubleslit":"","f_orbitals":"","f_uncertainty":""}}