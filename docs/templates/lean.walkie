{"format":"walkie-board-backup","v":1,"created":"2026-11-05T09:00:00+00:00","board":"사업 기획 (린 캔버스)","objects":[{"kind":"text","text":"사업 기획 — 린 캔버스","x":40,"y":20,"w":1800,"h":0,"fontSize":56,"color":"#1A1D26","width":3,"tool":"","rotation":0,"font":"serif","tfmt":"b","id":"o1"},{"kind":"text","text":"번호 순서대로 채우면 좋아요: 고객 → 문제 → 가치 제안 → 해결책 → 채널 → 수익 → 비용 → 지표 → 경쟁 우위.","x":44,"y":104,"w":1800,"h":0,"fontSize":22,"color":"#4A5163","width":3,"tool":"","rotation":0,"id":"o2"},{"kind":"frame","text":"{\"title\": \"2. 문제\", \"color\": \"#B3261E\"}","x":40,"y":200.0,"w":540,"h":1130.0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o3"},{"kind":"text","text":"가장 큰 문제 3가지 · 지금은 어떻게 해결하나요?","x":64,"y":220.0,"w":492,"h":0,"fontSize":18,"color":"#4A5163","width":3,"tool":"","rotation":0,"id":"o4"},{"kind":"text","text":"","x":64,"y":280.0,"w":492,"h":0,"fontSize":18,"color":"#1A1D26","bg":"#FFF3A6","width":3,"tool":"","rotation":0,"id":"o5"},{"kind":"frame","text":"{\"title\": \"4. 해결책\", \"color\": \"#1F4FD8\"}","x":610,"y":200.0,"w":540,"h":550.0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o6"},{"kind":"text","text":"문제마다 가장 간단한 해결","x":634,"y":220.0,"w":492,"h":0,"fontSize":18,"color":"#4A5163","width":3,"tool":"","rotation":0,"id":"o7"},{"kind":"text","text":"","x":634,"y":280.0,"w":492,"h":0,"fontSize":18,"color":"#1A1D26","bg":"#FFF3A6","width":3,"tool":"","rotation":0,"id":"o8"},{"kind":"frame","text":"{\"title\": \"8. 핵심 지표\", \"color\": \"#4A5163\"}","x":610,"y":780.0,"w":540,"h":550.0,"color":"#1A1D26","width":3,"tool":"","fontSize":20,"rotation":0,"id":"o9"},{"kind":"text","text":"무엇을 재면 잘되고 있는지 아나요?","x":634,"y":800.0,"w":492,"h":0,"fontSize":18,"color":"#4A5163","width":3,"tool":"","rotation":0,"id":"o10"},{"kind":"text","text":"","x":634,"y":860.0,"w":492,"h":0,"fontSize":18,"color":"#1A1D26","bg":"#FFF3A6","width":3,"tool":"","rotation":0,"id":"o11"},{"kind":"frame","text":"{\"title\": \"3. 고유 가치 제안\", \"color\"